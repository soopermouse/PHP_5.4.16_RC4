+			error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time,
+				PG(modules_activated) && EG(active) TSRMLS_CC);
 			len = spprintf(&tmp, 0, "[%s] %s%s", error_time_str, log_message, PHP_EOL);
 #ifdef PHP_WIN32
